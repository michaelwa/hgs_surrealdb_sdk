{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "type": "mix_task",
            "name": "mix (Default task)",
            "request": "launch",
            "projectDir": "${workspaceRoot}"
        },
        {
            "type": "mix_task",
            "name": "mix test",
            "request": "launch",
            "task": "test",
            "taskArgs": [
                "--trace"
            ],
            "startApps": true,
            "projectDir": "${workspaceRoot}",
            "requireFiles": [
                "test/**/test_helper.exs",
                "test/**/*_test.exs"
            ]
        },
        {
            "type": "edb",
            "request": "launch",
            "name": "Launch Erlang Application",
            "runInTerminal": {
                "kind": "integrated",
                "cwd": "${workspaceFolder}",
                "args": [
                    "erl",
                    "-name",
                    "debuggee@localhost"
                ]
            },
            "config": {
                "nameDomain": "longnames",
                "stripSourcePrefix": "${workspaceFolder}/",
                "timeout": 60
            }
        },
        {
            "type": "edb",
            "request": "attach",
            "name": "Attach to Erlang node",
            "node": "mynode@localhost",
            "cookie": "mycookie",
            "cwd": "${workspaceFolder}",
            "stripSourcePrefix": "${workspaceFolder}/"
        }
    ]
}